# Backend server URL:
# For HTTPS (recommended for LAN / domain access & WebRTC microphone support):
VITE_SERVER_URL=https://lan.jomlepark.cc:2567

# For HTTP local development (leave empty or use http://lan.jomlepark.cc:2567):
# VITE_SERVER_URL=http://lan.jomlepark.cc:2567

# Enable HTTPS locally (set true for self-signed or custom HTTPS, false for plain HTTP):
VITE_HTTPS=true

# Optional: Path to custom certificates (if not specified, auto-generates or uses certs/ directory)
# SSL_CERT_PATH=../certs/cert.pem
# SSL_KEY_PATH=../certs/key.pem
