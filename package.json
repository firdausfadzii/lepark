{
  "name": "lepark",
  "version": "1.0.0",
  "private": true,
  "description": "Lepark - Multiplayer web game with Colyseus, Phaser 3, and PostgreSQL in Docker",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:export": "node scripts/db-export.js",
    "db:import": "node scripts/db-import.js",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:shared": "npm run build --workspace=shared",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:shared && npm run build:server && npm run build:client"
  },
  "dependencies": {
    "chess.js": "^1.4.0"
  }
}
